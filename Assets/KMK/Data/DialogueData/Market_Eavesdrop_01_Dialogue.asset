  textLines:
  - speakerName: A
    text: "\uC544\uCE68\uC5D0 \uB610 \uD55C\uBA85\uC774 \uC4F0\uB7EC\uC84C\uB2E4\uB354\uAD70."
  - speakerName: B
    text: "\uBA40\uCA61\uD558\uB358 \uC0AC\uB78C\uC774..."
  - speakerName: A
    text: "\uADF8\uB098\uC800\uB098 \uC624\uB298 \uB0AF\uC120 \uC0AC\uB78C \uBCF4\uC168\uC18C?"
  - speakerName: B
    text: "\uC678\uBD80\uC778\uC774 \uB4E4\uC5B4\uC654\uB098?"
  - speakerName: A
    text: "\uB9C8\uC744 \uC785\uAD6C \uCABD\uC5D0\uC11C \uBD24\uB2E4\uB294 \uC18C\uBB38\uC774.."
